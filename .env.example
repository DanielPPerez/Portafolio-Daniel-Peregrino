# --- Calendario ---
# URL pública del iframe de Google Calendar (reemplaza el placeholder del sitio).
NEXT_PUBLIC_CALENDAR_SRC="https://calendar.google.com/calendar/embed?src=TU_CALENDARIO&ctz=America%2FMexico_City"
# URL pública de reserva de citas (Horario de Citas) para el widget de calificacion.
NEXT_PUBLIC_CALENDAR_BOOKING_SRC=""

# --- Cotizador IA (Shadow360) ---
GOOGLE_API_KEY=
GEMINI_MODEL=

# --- Gmail (para formulario de contacto) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=
# Si el GMAIL_REFRESH_TOKEN expira o se revoca, generar uno nuevo vía
# OAuth Playground (https://developers.google.com/oauthplayground) con
# los alcances: https://mail.google.com/, https://www.googleapis.com/auth/gmail.send
# y actualizar este archivo.

