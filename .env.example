# Variables de entorno previstas. El frontend actual no requiere ninguna para correr.
# Copia este archivo a `.env.local` y completa los valores que necesites.

# URL pública del iframe de Google Calendar (reemplaza el placeholder del sitio).
NEXT_PUBLIC_CALENDAR_SRC="https://calendar.google.com/calendar/embed?src=TU_CALENDARIO&ctz=America%2FMexico_City"

# Futuro (cotizador con LLM, lado servidor). NO exponer en el cliente (sin prefijo NEXT_PUBLIC_).
# ANTHROPIC_API_KEY=""
