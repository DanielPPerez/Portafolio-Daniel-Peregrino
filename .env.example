# --- Calendario ---
# URL pública de reserva de citas (Horario de Citas) para el widget de calificacion.
NEXT_PUBLIC_CALENDAR_BOOKING_SRC=""

# --- Cotizador IA (Shadow360) ---
GOOGLE_API_KEY=
# Default: gemini-2.5-flash-lite (más barato con structured outputs, ADR-0014).
# Alternativa con mejor adherencia a JSON schema: gemini-3.1-flash-lite.
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Gmail (para formulario de contacto) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=
# Si el GMAIL_REFRESH_TOKEN expira o se revoca, generar uno nuevo vía
# OAuth Playground (https://developers.google.com/oauthplayground) con
# los alcances: https://mail.google.com/, https://www.googleapis.com/auth/gmail.send
# y actualizar este archivo.

# --- Supabase (próximas fases: proyectos, certificaciones, CV, leads, admin) ---
# NEXT_PUBLIC_SUPABASE_URL=""
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""        # solo servidor (@sensitive)
SCREENSHOT_API_KEY=""